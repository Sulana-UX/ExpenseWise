# ------------------------------------------------------------------------------
# Secure Smart Expense Tracker - Backend Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE SECRETS SAFELY FOR LOCAL DEVELOPMENT.
# NEVER COMMIT THE ACTUAL .env FILE OR REAL PRODUCTION SECRETS TO GIT!
# ------------------------------------------------------------------------------

# Application Environment (development, testing, production)
APP_ENV=development

# Database Connection (SQLite local file)
DATABASE_URL=sqlite:///./expense_tracker.db

# JWT Authentication Secret Key (Generate a random 32+ char cryptographic secret in production)
# e.g., openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_super_secure_random_32_character_secret_key_12345
JWT_ALGORITHM=HS256

# JWT Access Token Expiration in Minutes (e.g., 60 minutes for short-lived tokens)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local Server Host and Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
